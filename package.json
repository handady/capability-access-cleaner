{
  "name": "capability-access-cleaner",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: fix an abnormally large CapabilityAccessManager.db-wal (camsvc WAL) that fills the C: drive on Windows.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "cleanup.ps1",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "capabilityaccessmanager",
    "camsvc",
    "windows"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  }
}
